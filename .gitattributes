# Normalize line endings — reduces Windows/Mac merge noise
* text=auto eol=lf

# Windows scripts keep CRLF if needed
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.rhai text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.pdf binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
