# Chalukya Tiles — production environment template
# Copy to .env on the server (never commit .env) and fill in real values.

# development | production
APP_ENV=production

# Public site URL (used in sitemap / absolute links)
SITE_URL=https://www.your-domain.com

# Allowed Host header values (comma-separated, no spaces required)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Strong random session secret (required in production, min 32 chars)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=replace-with-long-random-string

# Optional: force Secure cookie even outside APP_ENV=production
# SESSION_HTTPS_ONLY=true

# Optional: open /api/docs on production (default: hidden when APP_ENV=production)
# ENABLE_API_DOCS=false

# Only used the FIRST time the database is created (new empty DB).
# After first run, change password inside Admin → User Management.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
